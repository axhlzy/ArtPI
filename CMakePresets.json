{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64-v8a Release",
      "description": "NDK from NDK_HOME env var, android-24, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm64-v8a",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "android-arm64-debug",
      "displayName": "Android arm64-v8a Debug",
      "description": "NDK from NDK_HOME env var, android-24, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm64-v8a-debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64-release",
      "configuration": "Release"
    },
    {
      "name": "android-arm64-debug",
      "configurePreset": "android-arm64-debug",
      "configuration": "Debug"
    }
  ]
}
